server {
    listen       ${PORT} default_server;
    listen       [::]:${PORT} default_server;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # QUAN TRỌNG: không dùng khối `types {}` ở đây -- nó sẽ THAY THẾ toàn bộ
    # bảng mime.types mặc định (chứ không phải bổ sung), khiến .html mất
    # luôn Content-Type text/html, rơi về default_type application/octet-stream
    # -> trình duyệt hiểu là file nhị phân và bật hộp thoại tải về (đây chính
    # là lỗi "index.html bị tải về dạng file"). mime.types mặc định đi kèm
    # nginx >=1.19.10 đã có sẵn .html, .js, .wasm đúng chuẩn, không cần khai
    # báo thêm gì.

    # nếu Unity build có Compression Format = Gzip (mặc định), Unity sẽ
    # sinh ra .data.gz/.wasm.gz/.framework.js.gz -- gzip_static tự phục vụ
    # đúng file nén kèm header Content-Encoding: gzip, không cần cấu hình gì thêm
    gzip_static on;
    gzip_vary   on;

    # index.html không cache, để mỗi lần deploy bản mới browser luôn lấy bản mới nhất
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # asset build & streaming assets: cache dài hạn, vì mỗi lần build lại
    # Unity thường tạo build mới hoàn toàn (thay cả thư mục)
    location /Build/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /StreamingAssets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
